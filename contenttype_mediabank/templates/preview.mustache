{{!
    @template contenttype_mediabank/preview

    Preview of a media bank item: the media, then its transcript.

    Context variables required for this template:
    * name - Name of the item
    * url - URL of the file
    * isvideo, isaudio, ispdf, isimage - Which kind of file it is (one is true)
    * alt - Text alternative for an image
    * captionsurl - URL of the WebVTT captions, empty if none
    * transcript - Written transcript, empty if none
    * nopreview - True when the file cannot be shown

    Example context (json):
    {
        "name": "Lecture 1",
        "url": "https://example.com/lecture1.mp4",
        "isvideo": true,
        "captionsurl": "https://example.com/captions.vtt",
        "transcript": "Welcome to the course."
    }
}}
<div class="contenttype-mediabank-preview">
    {{#isvideo}}
        <video src="{{url}}" controls preload="metadata" class="w-100" aria-label="{{name}}">
            {{#captionsurl}}<track kind="captions" src="{{captionsurl}}" label="{{#str}} captions, contenttype_mediabank {{/str}}" default>{{/captionsurl}}
        </video>
    {{/isvideo}}
    {{#isaudio}}
        <audio src="{{url}}" controls preload="metadata" class="w-100" aria-label="{{name}}">
            {{#captionsurl}}<track kind="captions" src="{{captionsurl}}" label="{{#str}} captions, contenttype_mediabank {{/str}}" default>{{/captionsurl}}
        </audio>
    {{/isaudio}}
    {{#ispdf}}
        <iframe src="{{url}}" title="{{name}}" class="w-100 contenttype-mediabank-pdf"></iframe>
    {{/ispdf}}
    {{#isimage}}
        <img src="{{url}}" alt="{{alt}}" class="img-fluid">
    {{/isimage}}
    {{#nopreview}}
        <p>{{#str}} unsupportedpreview, contenttype_mediabank {{/str}}</p>
    {{/nopreview}}
    {{#transcript}}
        <details class="mt-3">
            <summary>{{#str}} transcript, contenttype_mediabank {{/str}}</summary>
            <p class="contenttype-mediabank-transcript">{{transcript}}</p>
        </details>
    {{/transcript}}
</div>
